<?xml version="1.0" encoding="utf-8"?>
<!--
  Local annotations for ZDPR_Q_TARGET_QUERY_CDS (analytical query).
  Card 4  ActualVsTargetOvp : monthly reconciled actual vs target per product
  Entity set ZDPR_Q_TARGET_QUERYResults, type ...Result (same convention as
  ZDPR_Q_BOEPD_TREND, confirmed 16/09/26). P_FiscalYear comes from the
  filter bar; P_TargetCode defaults to TAR_BE until step 7 adds it to the bar.
-->
<edmx:Edmx Version="4.0" xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx">
  <edmx:Reference Uri="https://sap.github.io/odata-vocabularies/vocabularies/UI.xml">
    <edmx:Include Namespace="com.sap.vocabularies.UI.v1" Alias="UI"/>
  </edmx:Reference>
  <edmx:Reference Uri="https://sap.github.io/odata-vocabularies/vocabularies/Common.xml">
    <edmx:Include Namespace="com.sap.vocabularies.Common.v1" Alias="Common"/>
  </edmx:Reference>
  <edmx:Reference Uri="/sap/opu/odata/sap/ZDPR_Q_TARGET_QUERY_CDS/$metadata">
    <edmx:Include Namespace="ZDPR_Q_TARGET_QUERY_CDS" Alias="SAP"/>
  </edmx:Reference>
  <edmx:DataServices>
    <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm" Namespace="zdprdashboard.annotations.target">

      <Annotations Target="ZDPR_Q_TARGET_QUERY_CDS.ZDPR_Q_TARGET_QUERYResult">

        <Annotation Term="UI.SelectionVariant" Qualifier="Params">
          <Record Type="UI.SelectionVariantType">
            <PropertyValue Property="Parameters">
              <Collection>
                <Record Type="UI.Parameter">
                  <PropertyValue Property="PropertyName" PropertyPath="P_FiscalYear"/>
                  <PropertyValue Property="PropertyValue" String="2024"/>
                </Record>
                <Record Type="UI.Parameter">
                  <PropertyValue Property="PropertyName" PropertyPath="P_TargetCode"/>
                  <PropertyValue Property="PropertyValue" String="TAR_BE"/>
                </Record>
              </Collection>
            </PropertyValue>
            <PropertyValue Property="SelectOptions">
              <Collection>
                <Record Type="UI.SelectOptionType">
                  <PropertyValue Property="PropertyName" PropertyPath="Product"/>
                  <PropertyValue Property="Ranges">
                    <Collection>
                      <Record Type="UI.SelectionRangeType">
                        <PropertyValue Property="Sign" EnumMember="UI.SelectionRangeSignType/I"/>
                        <PropertyValue Property="Option" EnumMember="UI.SelectionRangeOptionType/EQ"/>
                        <PropertyValue Property="Low" String="722000001"/>
                      </Record>
                      <Record Type="UI.SelectionRangeType">
                        <PropertyValue Property="Sign" EnumMember="UI.SelectionRangeSignType/I"/>
                        <PropertyValue Property="Option" EnumMember="UI.SelectionRangeOptionType/EQ"/>
                        <PropertyValue Property="Low" String="722000003"/>
                      </Record>
                      <Record Type="UI.SelectionRangeType">
                        <PropertyValue Property="Sign" EnumMember="UI.SelectionRangeSignType/I"/>
                        <PropertyValue Property="Option" EnumMember="UI.SelectionRangeOptionType/EQ"/>
                        <PropertyValue Property="Low" String="722000004"/>
                      </Record>
                      <Record Type="UI.SelectionRangeType">
                        <PropertyValue Property="Sign" EnumMember="UI.SelectionRangeSignType/I"/>
                        <PropertyValue Property="Option" EnumMember="UI.SelectionRangeOptionType/EQ"/>
                        <PropertyValue Property="Low" String="722000005"/>
                      </Record>
                    </Collection>
                  </PropertyValue>
                </Record>
              </Collection>
            </PropertyValue>
          </Record>
        </Annotation>

        <Annotation Term="UI.Chart" Qualifier="ActualVsTargetOvp">
          <Record Type="UI.ChartDefinitionType">
            <PropertyValue Property="Title" String="Target vs Actual by Product"/>
            <PropertyValue Property="ChartType" EnumMember="UI.ChartType/Column"/>
            <PropertyValue Property="Dimensions">
              <Collection>
                <PropertyPath>ProductDescription</PropertyPath>
              </Collection>
            </PropertyValue>
            <PropertyValue Property="DimensionAttributes">
              <Collection>
                <Record Type="UI.ChartDimensionAttributeType">
                  <PropertyValue Property="Dimension" PropertyPath="ProductDescription"/>
                  <PropertyValue Property="Role" EnumMember="UI.ChartDimensionRoleType/Category"/>
                </Record>
              </Collection>
            </PropertyValue>
            <PropertyValue Property="Measures">
              <Collection>
                <PropertyPath>ActualQty</PropertyPath>
                <PropertyPath>TargetQty</PropertyPath>
              </Collection>
            </PropertyValue>
            <PropertyValue Property="MeasureAttributes">
              <Collection>
                <Record Type="UI.ChartMeasureAttributeType">
                  <PropertyValue Property="Measure" PropertyPath="ActualQty"/>
                  <PropertyValue Property="Role" EnumMember="UI.ChartMeasureRoleType/Axis1"/>
                </Record>
                <Record Type="UI.ChartMeasureAttributeType">
                  <PropertyValue Property="Measure" PropertyPath="TargetQty"/>
                  <PropertyValue Property="Role" EnumMember="UI.ChartMeasureRoleType/Axis1"/>
                </Record>
              </Collection>
            </PropertyValue>
          </Record>
        </Annotation>


        <!-- view switch tab: x-axis AssetDescription, series ProductDescription -->
        <Annotation Term="UI.Chart" Qualifier="ByAsset">
          <Record Type="UI.ChartDefinitionType">
            <PropertyValue Property="Title" String="Target vs Actual by Asset"/>
            <PropertyValue Property="ChartType" EnumMember="UI.ChartType/Column"/>
            <PropertyValue Property="Dimensions">
              <Collection>
                <PropertyPath>AssetDescription</PropertyPath>
                <PropertyPath>ProductDescription</PropertyPath>
              </Collection>
            </PropertyValue>
            <PropertyValue Property="DimensionAttributes">
              <Collection>
                <Record Type="UI.ChartDimensionAttributeType">
                  <PropertyValue Property="Dimension" PropertyPath="AssetDescription"/>
                  <PropertyValue Property="Role" EnumMember="UI.ChartDimensionRoleType/Category"/>
                </Record>
                <Record Type="UI.ChartDimensionAttributeType">
                  <PropertyValue Property="Dimension" PropertyPath="ProductDescription"/>
                  <PropertyValue Property="Role" EnumMember="UI.ChartDimensionRoleType/Series"/>
                </Record>
              </Collection>
            </PropertyValue>
            <PropertyValue Property="Measures">
              <Collection>
                <PropertyPath>ActualQty</PropertyPath>
                <PropertyPath>TargetQty</PropertyPath>
              </Collection>
            </PropertyValue>
            <PropertyValue Property="MeasureAttributes">
              <Collection>
                <Record Type="UI.ChartMeasureAttributeType">
                  <PropertyValue Property="Measure" PropertyPath="ActualQty"/>
                  <PropertyValue Property="Role" EnumMember="UI.ChartMeasureRoleType/Axis1"/>
                </Record>
                <Record Type="UI.ChartMeasureAttributeType">
                  <PropertyValue Property="Measure" PropertyPath="TargetQty"/>
                  <PropertyValue Property="Role" EnumMember="UI.ChartMeasureRoleType/Axis1"/>
                </Record>
              </Collection>
            </PropertyValue>
          </Record>
        </Annotation>

        <Annotation Term="UI.PresentationVariant" Qualifier="ByAsset">
          <Record Type="UI.PresentationVariantType">
            <PropertyValue Property="SortOrder">
              <Collection>
                <Record Type="Common.SortOrderType">
                  <PropertyValue Property="Property" PropertyPath="AssetDescription"/>
                  <PropertyValue Property="Descending" Bool="false"/>
                </Record>
              </Collection>
            </PropertyValue>
            <PropertyValue Property="Visualizations">
              <Collection>
                <AnnotationPath>@UI.Chart#ByAsset</AnnotationPath>
              </Collection>
            </PropertyValue>
          </Record>
        </Annotation>

        <!-- view switch tab: x-axis FiscalPeriod, series ProductDescription -->
        <Annotation Term="UI.Chart" Qualifier="ByPeriod">
          <Record Type="UI.ChartDefinitionType">
            <PropertyValue Property="Title" String="Target vs Actual by Fiscal Period"/>
            <PropertyValue Property="ChartType" EnumMember="UI.ChartType/Column"/>
            <PropertyValue Property="Dimensions">
              <Collection>
                <PropertyPath>FiscalPeriod</PropertyPath>
                <PropertyPath>ProductDescription</PropertyPath>
              </Collection>
            </PropertyValue>
            <PropertyValue Property="DimensionAttributes">
              <Collection>
                <Record Type="UI.ChartDimensionAttributeType">
                  <PropertyValue Property="Dimension" PropertyPath="FiscalPeriod"/>
                  <PropertyValue Property="Role" EnumMember="UI.ChartDimensionRoleType/Category"/>
                </Record>
                <Record Type="UI.ChartDimensionAttributeType">
                  <PropertyValue Property="Dimension" PropertyPath="ProductDescription"/>
                  <PropertyValue Property="Role" EnumMember="UI.ChartDimensionRoleType/Series"/>
                </Record>
              </Collection>
            </PropertyValue>
            <PropertyValue Property="Measures">
              <Collection>
                <PropertyPath>ActualQty</PropertyPath>
                <PropertyPath>TargetQty</PropertyPath>
              </Collection>
            </PropertyValue>
            <PropertyValue Property="MeasureAttributes">
              <Collection>
                <Record Type="UI.ChartMeasureAttributeType">
                  <PropertyValue Property="Measure" PropertyPath="ActualQty"/>
                  <PropertyValue Property="Role" EnumMember="UI.ChartMeasureRoleType/Axis1"/>
                </Record>
                <Record Type="UI.ChartMeasureAttributeType">
                  <PropertyValue Property="Measure" PropertyPath="TargetQty"/>
                  <PropertyValue Property="Role" EnumMember="UI.ChartMeasureRoleType/Axis1"/>
                </Record>
              </Collection>
            </PropertyValue>
          </Record>
        </Annotation>

        <Annotation Term="UI.PresentationVariant" Qualifier="ByPeriod">
          <Record Type="UI.PresentationVariantType">
            <PropertyValue Property="SortOrder">
              <Collection>
                <Record Type="Common.SortOrderType">
                  <PropertyValue Property="Property" PropertyPath="FiscalPeriod"/>
                  <PropertyValue Property="Descending" Bool="false"/>
                </Record>
              </Collection>
            </PropertyValue>
            <PropertyValue Property="Visualizations">
              <Collection>
                <AnnotationPath>@UI.Chart#ByPeriod</AnnotationPath>
              </Collection>
            </PropertyValue>
          </Record>
        </Annotation>

        <!-- BOC By Arnav on 22/09/26
             Card navigation (README step 9): header click opens the detail app
             ZDPRTARGET on ZDPR_Q_TARGET_QUERY_CDS. SemanticObject/Action = target mapping DPRTarget-display. -->
        <Annotation Term="UI.Identification">
          <Collection>
            <Record Type="UI.DataFieldForIntentBasedNavigation">
              <PropertyValue Property="Label" String="Target vs actual"/>
              <PropertyValue Property="SemanticObject" String="DPRTarget"/>
              <PropertyValue Property="Action" String="display"/>
            </Record>
          </Collection>
        </Annotation>
        <!-- EOC By Arnav on 22/09/26 -->

      </Annotations>
    </Schema>
  </edmx:DataServices>
</edmx:Edmx>
