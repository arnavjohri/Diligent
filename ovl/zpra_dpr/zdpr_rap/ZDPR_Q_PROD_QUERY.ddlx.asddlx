
@Metadata.layer: #CUSTOMER

@UI.headerInfo: {
  typeName:       'Production Record',
  typeNamePlural: 'Production Record',
  title:          { type: #STANDARD, value: 'ProductDescription' },
  description:    { type: #STANDARD, value: 'AssetDescription' }
}

// BOC By Arnav on 24/09/26
// Old chart: no dimension/measure attributes (SmartChart crash), presentation
// variant referenced the default @UI.Chart which does not exist, and the
// measures carry a per-product unit (M3/BBL) so Oil and Gas could not be
// drawn together. New default: OVL Share (BOE) per asset, unit-free.
//@UI.chart: [{
//  qualifier:  'ByDate',
//  title:      'Daily Production by Product',
//  chartType:  #COLUMN,
//  dimensions: ['ProductionDate', 'ProductDescription'],
//  measures:   ['ProdQty1', 'OvlShareQty1']
//}]
//
//@UI.presentationVariant: [{
//  visualizations: [
//    { type: #AS_CHART },
//    { type: #AS_LINEITEM }
//  ]
//}]

@UI.chart: [{
  qualifier:           'ByAsset',
  title:               'OVL Share by Asset (BOE)',
  chartType:           #COLUMN,
  dimensions:          ['AssetDescription'],
  dimensionAttributes: [{ dimension: 'AssetDescription', role: #CATEGORY }],
  measures:            ['OvlShareBoe'],
  measureAttributes:   [{ measure: 'OvlShareBoe', role: #AXIS_1 }]
}]

@UI.presentationVariant: [{
  sortOrder: [{ by: 'OvlShareBoe', direction: #DESC }],
  visualizations: [
    { type: #AS_CHART, qualifier: 'ByAsset' },
    { type: #AS_LINEITEM }
  ]
}]
// EOC By Arnav on 24/09/26

annotate view ZDPR_Q_PROD_QUERY with
{
  @UI.selectionField: [{ position: 10 }]
  @UI.lineItem: [{ position: 10, importance: #HIGH, label: 'Date' }]
  ProductionDate;

  @UI.selectionField: [{ position: 20 }]
  CalendarYear;

  @UI.selectionField: [{ position: 30 }]
  CalendarMonth;

  @UI.selectionField: [{ position: 40 }]
  Product;

  @UI.selectionField: [{ position: 50 }]
  Asset;

  @UI.selectionField: [{ position: 60 }]
  VolumeType;

  @UI.lineItem: [{ position: 20, importance: #HIGH, label: 'Product' }]
  ProductDescription;

  @UI.lineItem: [{ position: 30, importance: #HIGH, label: 'Asset' }]
  AssetDescription;

  @UI.lineItem: [{ position: 40, importance: #MEDIUM, label: 'Block' }]
  Block;

  @UI.lineItem: [{ position: 50, importance: #MEDIUM, label: 'Volume Type' }]
  VolumeTypeDescription;

  @UI.lineItem: [{ position: 60, importance: #HIGH, label: 'JV Production (UoM1)' }]
  @UI.dataPoint: { title: 'Total JV Production' }
  ProdQty1;

  @UI.lineItem: [{ position: 70, importance: #LOW, label: 'UoM' }]
  ProdUom1;

  @UI.lineItem: [{ position: 80, importance: #HIGH, label: 'OVL Share (UoM1)' }]
  @UI.dataPoint: { title: 'OVL Share' }
  OvlShareQty1;

  @UI.lineItem: [{ position: 90, importance: #MEDIUM, label: 'JV Production (UoM2)' }]
  ProdQty2;

  @UI.lineItem: [{ position: 100, importance: #MEDIUM, label: 'OVL Share (UoM2)' }]
  OvlShareQty2;

  @UI.lineItem: [{ position: 110, importance: #LOW, label: 'PI %' }]
  ParticipatingInterest;

  // BOC By Arnav on 24/09/26
  @UI.lineItem: [{ position: 120, importance: #HIGH, label: 'JV Production (BOE)' }]
  BoepdQty;

  @UI.lineItem: [{ position: 130, importance: #HIGH, label: 'OVL Share (BOE)' }]
  @UI.dataPoint: { title: 'OVL Share (BOE)' }
  OvlShareBoe;
  // EOC By Arnav on 24/09/26
}
